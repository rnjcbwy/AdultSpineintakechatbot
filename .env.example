# Adult Spine Intake — environment. Copy to .env.local for development.
# Production values are set on the Amplify app by scripts/aws/amplify-configure.mjs;
# the only secret (the Practice Hub service key) is read from Secrets Manager.

# prototype (default; loud warnings, fictional data) | production (the AWS deployment)
DEPLOYMENT_TIER=prototype
NEXT_PUBLIC_DEPLOYMENT_TIER=prototype

# --- Language model --------------------------------------------------------
# bedrock (default; covered by the AWS BAA, credentials from the runtime role or
# your AWS profile) | openai (local experiments only; never real patient data)
LLM_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
BEDROCK_NOTE_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-6
# OPENAI_API_KEY=

# --- Submissions store ------------------------------------------------------
# Unset: a folder under .data/ (development). Set: the KMS-encrypted bucket.
# SPINE_SUBMISSIONS_BUCKET=spine-intake-submissions-<account>-us-east-1
# SPINE_KMS_KEY_ARN=arn:aws:kms:us-east-1:<account>:key/<id>

# --- Worker -----------------------------------------------------------------
# Unset: the note/transcript/hand-off run inside this process (development).
# Set: invoked asynchronously (production).
# INTAKE_WORKER_FUNCTION=spine-intake-worker

# --- Practice Hub hand-off --------------------------------------------------
# Unset: submissions are stored but not forwarded.
# PRACTICEHUB_URL=https://d1pa387yp1vkq0.cloudfront.net
# Production: the Secrets Manager secret holding the shared service key.
# PRACTICEHUB_API_KEY_SECRET_ID=practicehub/INTAKE_API_KEY
# Development against a local Practice Hub (npm run dev on port 3100):
# PRACTICEHUB_URL=http://localhost:3100
# PRACTICEHUB_API_KEY=<same value as INTAKE_API_KEY in practice-hub/.env.local>

# --- Legacy office cabinet (/authorization, /api/patients) ------------------
# CLINICIAN_PASSWORD=

# "Finish later" links can be emailed to the patient through Amazon SES (the
# message holds the link only). A verified SES identity, e.g.
#   EMAIL_FROM="Dr. Aaron Wey's office <office@example.com>"
# Leave unset and the form offers the link to copy or to open in a mail app.
# EMAIL_FROM=
